open Lean Elab Command

set_option maxHeartbeats 0 in
elab "#audit_owned " ids:ident* : command => do
  let env ← getEnv
  let mut indices : Std.HashSet Nat := {}
  for id in ids do
    let some idx := env.getModuleIdx? id.getId | throwError "Missing audited module {id.getId}"
    indices := indices.insert idx.toNat
  let declarations := env.constants.fold (init := #[]) fun names name _ =>
    match env.getModuleIdxFor? name with
    | some idx => if indices.contains idx.toNat then names.push name else names
    | none => names
  let mut failures : Nat := 0
  for name in declarations do
    let axioms ← collectAxioms name
    for dependency in axioms do
      unless dependency == ``propext || dependency == ``Classical.choice || dependency == ``Quot.sound do
        logError m!"{name} depends on {dependency}"
        failures := failures + 1
  logInfo m!"Checked {declarations.size} declarations in {indices.size} modules. Unexpected axiom uses: {failures}."

